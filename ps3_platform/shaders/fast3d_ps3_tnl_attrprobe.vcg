// Diagnostic variant of fast3d_ps3_tnl.vcg (debug menu "GPU vertex path: ATTR PROBE"):
// no constants at all. Each vertex is placed from its raw model coordinates (scaled
// down), plain white, drawn without depth test or culling. Shapes on screen = the RSX
// reads the vertex records (the transform constants are at fault); nothing = the
// vertex records themselves don't arrive.
void main(float4 pos : POSITION, float4 tc : TEXCOORD0, float4 cn : COLOR0,
          out float4 outPosition : POSITION, out float4 outUv : TEXCOORD0,
          out float4 outK0 : TEXCOORD1, out float4 outK1 : TEXCOORD2, out float4 outK2 : TEXCOORD3,
          out float4 outK3 : TEXCOORD4, out float4 outK4 : TEXCOORD5, out float4 outState : TEXCOORD6) {
    outPosition = float4(pos.x * (1.0 / 2048.0), pos.y * (1.0 / 2048.0), 0.5, 1.0);
    outUv = float4(tc.xy * 0.0, 0.0, 0.0);
    outK0 = float4(0.0, 0.0, 0.0, 0.0);
    outK1 = float4(0.0, 0.0, 0.0, 0.0);
    outK2 = float4(0.0, 0.0, 0.0, 1.0) + cn * 0.0 + pos.z * 0.0 + pos.w * 0.0;
    outK3 = float4(0.0, 0.0, 0.0, 0.0);
    outK4 = float4(1.0, 1.0, 1.0, 0.0);
    outState = float4(0.0, 0.0, 0.0, 0.0);
}
