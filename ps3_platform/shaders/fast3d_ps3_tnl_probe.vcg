// Diagnostic variant of fast3d_ps3_tnl.vcg (USRDIR/tnl_probe): only the transform
// through the palette constants; every vertex is plain white (k4 = 1, alpha 1).
// White shapes = transform and vertex fetch work (the colour part is at fault);
// nothing = the transform/constants/fetch path is at fault.
void main(float4 pos : POSITION, float4 tc : TEXCOORD0, float4 cn : TEXCOORD1,
          uniform float4 C[460],
          out float4 outPosition : POSITION, out float4 outUv : TEXCOORD0,
          out float4 outK0 : TEXCOORD1, out float4 outK1 : TEXCOORD2, out float4 outK2 : TEXCOORD3,
          out float4 outK3 : TEXCOORD4, out float4 outK4 : TEXCOORD5, out float4 outState : TEXCOORD6) {
    // The CPU stores the constant index 40 + 15 * slot; indexing with the float keeps
    // Cg to one address register component (PSL1GHT cgcomp mishandles A0.y).
    float b = pos.w;
    outPosition = pos.x * C[b] + pos.y * C[b + 1] + pos.z * C[b + 2] + C[b + 3];
    outUv = float4(tc.xy * 0.0, 0.0, 0.0);
    outK0 = float4(0.0, 0.0, 0.0, 0.0);
    outK1 = float4(0.0, 0.0, 0.0, 0.0);
    outK2 = float4(0.0, 0.0, 0.0, 1.0) + cn * 0.0;
    outK3 = float4(0.0, 0.0, 0.0, 0.0);
    outK4 = float4(1.0, 1.0, 1.0, 0.0);
    outState = float4(0.0, 0.0, 0.0, 0.0);
}
